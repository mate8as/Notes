@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

@foreach (var cursor in OtherUserCursors.Values)
{
    <div class="remote-cursor" style="@GetCursorStyle(cursor)">
        @if (IsMoving(cursor))
        {
            <div class="remote-cursor__motion" style="@GetMotionStyle(cursor)" aria-hidden="true">
                <svg viewBox="0 0 40 40" preserveAspectRatio="none">
                    <path d="M36 20 Q30 18 8 36 Q20 20 8 4 Q30 22 36 20 Z" />
                </svg>
            </div>
        }

        <div class="remote-cursor__avatar">
            <MudAvatar Style="background-color:var(--cursor-color);color:var(--cursor-contrast);">
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" />
            </MudAvatar>
        </div>
    </div>
}

@code {
    private const double VelocitySmoothingSeconds = 0.055;
    private const double MaximumVisualSpeed = 1400;
    private static readonly TimeSpan CursorStopThreshold = TimeSpan.FromMilliseconds(250);

    [Parameter]
    public string userId { get; set; } = string.Empty;

    [Parameter]
    public string NoteId { get; set; } = string.Empty;

    private HubConnection? hubConnection;
    private DotNetObjectReference<CursorTracker>? dotNetReference;
    private readonly Dictionary<string, RemoteCursorState> OtherUserCursors = new(5, StringComparer.Ordinal);
    private Timer? cursorTimer;
    private bool renderPending;
    private bool renderedMovingCursor;
    private bool disposed;

    protected override void OnInitialized()
    {
        cursorTimer = new Timer(_ =>
        {
            if (!disposed)
                _ = InvokeAsync(RenderCursorChanges);
        }, null, 0, 50);
    }

    private void RenderCursorChanges()
    {
        var hasMovingCursor = OtherUserCursors.Values.Any(IsMoving);

        // Continue rendering while a tail is visible, then render once more to
        // remove it when movement stops. Stationary cursors cause no timer renders.
        if (!renderPending && !hasMovingCursor && !renderedMovingCursor)
            return;

        renderPending = false;
        renderedMovingCursor = hasMovingCursor;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        dotNetReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("CursorHelper.SetDotnetReference", dotNetReference);

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/noteshub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string, int, int>("ReceiveCursorUpdate", HandleReceiveCursorUpdate);

        try
        {
            await hubConnection.StartAsync();
            await hubConnection.SendAsync("JoinNote", NoteId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("SignalR connection failed: " + ex.Message);
        }
    }

    private Task HandleReceiveCursorUpdate(string otherUserId, int positionX, int positionY)
    {
        return InvokeAsync(() =>
        {
            UpdateCursor(otherUserId, positionX, positionY, DateTime.UtcNow);
            renderPending = true;
        });
    }

    private void UpdateCursor(string otherUserId, int positionX, int positionY, DateTime now)
    {
        if (!OtherUserCursors.TryGetValue(otherUserId, out var cursor))
        {
            var color = CreateCursorColor(otherUserId);
            OtherUserCursors[otherUserId] = new RemoteCursorState
            {
                X = positionX,
                Y = positionY,
                Color = color.Background,
                ContrastColor = color.Foreground,
                LastSampleAt = now,
                LastMoveAt = now
            };
            return;
        }

        var dx = positionX - cursor.X;
        var dy = positionY - cursor.Y;
        var elapsedSeconds = (now - cursor.LastSampleAt).TotalSeconds;

        cursor.X = positionX;
        cursor.Y = positionY;
        cursor.LastSampleAt = now;

        if (elapsedSeconds <= 0 || (dx == 0 && dy == 0))
            return;

        // A minimum interval prevents a burst of queued network messages from
        // producing an unrealistic speed spike.
        elapsedSeconds = Math.Max(elapsedSeconds, 1.0 / 120.0);

        var measuredVelocityX = dx / elapsedSeconds;
        var measuredVelocityY = dy / elapsedSeconds;
        var smoothing = elapsedSeconds > CursorStopThreshold.TotalSeconds
            ? 1.0
            : 1.0 - Math.Exp(-elapsedSeconds / VelocitySmoothingSeconds);

        cursor.VelocityX += (measuredVelocityX - cursor.VelocityX) * smoothing;
        cursor.VelocityY += (measuredVelocityY - cursor.VelocityY) * smoothing;
        cursor.LastMoveAt = now;
    }

    private static bool IsMoving(RemoteCursorState cursor)
    {
        return DateTime.UtcNow - cursor.LastMoveAt < CursorStopThreshold
            && cursor.Speed > 20;
    }

    private static string GetCursorStyle(RemoteCursorState cursor)
    {
        return FormattableString.Invariant(
            $"left:{cursor.X}px;top:{cursor.Y}px;--cursor-color:{cursor.Color};--cursor-contrast:{cursor.ContrastColor};");
    }

    private static (string Background, string Foreground) CreateCursorColor(string id)
    {
        // FNV-1a gives every user a stable pseudo-random hue on every client.
        // A fixed saturation/lightness keeps the colors lively in both themes.
        uint hash = 2166136261;
        foreach (var character in id)
        {
            hash ^= character;
            hash *= 16777619;
        }

        var hue = hash % 360;
        const double saturation = 0.72;
        const double lightness = 0.45;
        var chroma = (1 - Math.Abs(2 * lightness - 1)) * saturation;
        var section = hue / 60.0;
        var secondary = chroma * (1 - Math.Abs(section % 2 - 1));

        var (red, green, blue) = section switch
        {
            < 1 => (chroma, secondary, 0.0),
            < 2 => (secondary, chroma, 0.0),
            < 3 => (0.0, chroma, secondary),
            < 4 => (0.0, secondary, chroma),
            < 5 => (secondary, 0.0, chroma),
            _ => (chroma, 0.0, secondary)
        };

        var match = lightness - chroma / 2;
        var redByte = (byte)Math.Round((red + match) * 255);
        var greenByte = (byte)Math.Round((green + match) * 255);
        var blueByte = (byte)Math.Round((blue + match) * 255);
        var background = $"#{redByte:X2}{greenByte:X2}{blueByte:X2}";
        var perceivedBrightness = (redByte * 299 + greenByte * 587 + blueByte * 114) / 1000;
        var foreground = perceivedBrightness > 145 ? "#171717" : "#FFFFFF";

        return (background, foreground);
    }

    private static string GetMotionStyle(RemoteCursorState cursor)
    {
        // Point the motion shape behind the avatar, like a tail being dragged.
        var angle = Math.Atan2(cursor.VelocityY, cursor.VelocityX) * 180.0 / Math.PI + 180;
        var intensity = Math.Clamp(cursor.Speed / MaximumVisualSpeed, 0, 1);
        // Most of the shape sits underneath the 40px avatar. As speed increases,
        // its tapered end grows beyond the circle and turns the combined
        // silhouette into a teardrop instead of a separate direction marker.
        var length = 22 + 42 * Math.Sqrt(intensity);
        var height = 34 + 6 * intensity;

        return FormattableString.Invariant(
            $"--motion-angle:{angle:0.###}deg;--motion-length:{length:0.###}px;--motion-height:{height:0.###}px;");
    }

    [JSInvokable]
    public async Task OnCursorMoved(int cursorX, int cursorY)
    {
        if (hubConnection?.State != HubConnectionState.Connected)
            return;

        await hubConnection.SendAsync("UpdateCursor", NoteId, userId, cursorX, cursorY);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        cursorTimer?.Dispose();

        if (hubConnection is not null)
            await hubConnection.DisposeAsync();

        if (dotNetReference is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("CursorHelper.ClearDotnetReference");
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disconnected, so there is no callback to clear.
            }
        }

        dotNetReference?.Dispose();
    }

    private sealed class RemoteCursorState
    {
        public int X { get; set; }
        public int Y { get; set; }
        public string Color { get; set; } = string.Empty;
        public string ContrastColor { get; set; } = string.Empty;
        public double VelocityX { get; set; }
        public double VelocityY { get; set; }
        public DateTime LastSampleAt { get; set; }
        public DateTime LastMoveAt { get; set; }
        public double Speed => Math.Sqrt(VelocityX * VelocityX + VelocityY * VelocityY);
    }
}
